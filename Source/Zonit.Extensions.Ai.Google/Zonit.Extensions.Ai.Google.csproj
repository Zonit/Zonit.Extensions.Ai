<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    
    <!-- Package-specific metadata -->
    <PackageId>Zonit.Extensions.Ai.Google</PackageId>
    <Title>Zonit.Extensions.Ai.Google</Title>
    <Description>Google Gemini provider for Zonit.Extensions.Ai. Supports Gemini 3.x Pro/Flash/Flash-Lite with thinking levels, Gemini 2.5, and embeddings.</Description>
    <PackageTags>ai;google;gemini;gemini-pro;gemini-flash;embeddings;llm</PackageTags>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Zonit.Extensions.Ai\Zonit.Extensions.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deterministic tests for the date-switched Gemini 3.8 Flash rate card. -->
    <InternalsVisibleTo Include="Zonit.Extensions.Ai.Tests" />
  </ItemGroup>
</Project>
